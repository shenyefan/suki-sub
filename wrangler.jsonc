{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sub",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "sub.syf.sh", "custom_domain": true }],
  "compatibility_date": "2025-09-02",
  // TanStack Start 服务端要求 node:async_hooks
  "compatibility_flags": ["nodejs_compat"],
  // /api、/download、/share → Hono 后端;其余 → TanStack SSR;scheduled → 定时任务
  "main": "./src/server/worker-entry.ts",
  // 部署前 `wrangler d1 create suki-sub` 并回填 database_id;本地 dev 占位即可
  "d1_databases": [
    {
      "binding": "SUKI_SUB_DB",
      "database_name": "suki-sub",
      "database_id": "b7a7f890-1568-4bac-8fd4-40f3e21144f2",
      "migrations_dir": "migrations"
    }
  ],
  // 部署前 `wrangler kv namespace create SUKI_SUB_CACHE` 并回填 id
  "kv_namespaces": [
    {
      "binding": "SUKI_SUB_CACHE",
      "id": "f0c35363a35a41a6818d05295ecc0018"
    }
  ],
  // 脚本操作符沙箱(Dynamic Workers;需 Workers 付费计划)
  "worker_loaders": [{ "binding": "SCRIPT_LOADER" }],
  // Gist 自动备份
  "triggers": {
    "crons": ["0 */6 * * *"]
  }
}
